# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Telegram Forum 群组 ID（自动检测，无需手动填写）
# CHAT_ID=

# 允许使用 Bot 的 Telegram 用户 ID（逗号分隔，0 = 允许所有人）
ALLOWED_USERS=0

# Hook 回调 HTTP 端口
BOT_PORT=5000

# GPT backend: uses the local Codex CLI's configured gateway and credentials.
# Optional model override for NEW Codex panes; otherwise use ~/.codex/config.toml.
# CODEX_MODEL=gpt-6-astra
# CODEX_BIN=codex

# Claude Code 用 API Key 计费时填写（已 `claude auth login` 登录则留空）；./setup 会帮你写入
# ANTHROPIC_API_KEY=

# 共享浏览器人工接管（可选）：手机能访问的中转机。不配置则浏览器池照常可用，只是不能请用户接管
# BROWSER_HELP_SSH_HOST=nas                       # ~/.ssh/config 里的 Host，需免密登录
# BROWSER_HELP_LISTEN=10.0.1.188:6801             # 中转机对外监听（路由转发到这里）
# BROWSER_HELP_PUBLIC_URL=https://nas.example:36801
# BROWSER_HELP_WEBSOCKIFY="/path/noVNC/websockify/run --ssl-only --web /path/noVNC --cert ... --key ..."
# BROWSER_POOL_SLOTS=2                           # 槽位数，硬上限 4
# BROWSER_POOL_MAX_TABS=6                        # 每个槽位最多标签页数
