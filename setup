#!/usr/bin/env bash
# code-anywhere 一键安装 / 自检：./setup（交互）  ./setup --yes（全部默认同意）  ./setup --check（只检查）
set -euo pipefail
cd "$(dirname "$0")"

python_ok() { command -v python3 >/dev/null && python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))'; }

if python_ok; then
  exec python3 provision/setup.py "$@"
fi
# 系统 Python 太老（例如 macOS 自带 3.9）：用 uv 的官方安装包装一个独立的 Python，不需要 sudo 或 Homebrew
echo "需要 Python 3.10+，用 uv 安装一个（不需要 sudo）…"
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
uv python install 3.12
exec "$(uv python find 3.12)" provision/setup.py "$@"
