#!/usr/bin/env bash
# code-anywhere 一键安装 / 自检：./setup（交互）  ./setup --yes（全部默认同意）  ./setup --check（只检查）
set -euo pipefail
cd "$(dirname "$0")"

python_ok() { command -v python3 >/dev/null && python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))'; }

if ! python_ok; then
  echo "需要 Python 3.10+，尝试自动安装…"
  if [ "$(uname)" = Darwin ]; then
    if command -v brew >/dev/null; then brew install python
    else echo "请先运行 xcode-select --install（自带 python3），或安装 Homebrew 后重试。" >&2; exit 1; fi
  elif command -v apt-get >/dev/null; then sudo apt-get update && sudo apt-get install -y python3
  elif command -v dnf >/dev/null; then sudo dnf install -y python3
  elif command -v yum >/dev/null; then sudo yum install -y python3
  elif command -v pacman >/dev/null; then sudo pacman -S --noconfirm python
  elif command -v zypper >/dev/null; then sudo zypper install -y python3
  elif command -v apk >/dev/null; then sudo apk add python3
  else echo "找不到包管理器，请手动安装 Python 3.10+ 后重试。" >&2; exit 1; fi
  python_ok || { echo "系统源里的 Python 版本低于 3.10，请手动安装新版本后重试。" >&2; exit 1; }
fi
exec python3 provision/setup.py "$@"
