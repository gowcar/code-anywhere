#!/usr/bin/env python3
"""issue-images <owner/repo> <issue 编号> —— 列出 issue 正文与评论里的图片在本机的原件路径（GitLab / GitHub）。"""
import json, os, re, shutil, subprocess, sys, urllib.request
from pathlib import Path

if len(sys.argv) != 3:
    sys.exit("用法: issue-images <owner/repo> <issue 编号>")
here = Path(__file__).resolve().parent
platform = subprocess.run([str(here / "issue-platform")], capture_output=True, text=True).stdout.strip()
if platform != "github":
    os.execv(str(here / "gitlab-issue-images"), [str(here / "gitlab-issue-images"), *sys.argv[1:]])

repo, number = sys.argv[1:]
token_file = Path.home() / ".config/github-token"
token = token_file.read_text().strip() if token_file.exists() else subprocess.run(
    [shutil.which("gh") or "gh", "auth", "token"], capture_output=True, text=True).stdout.strip()


def api(path):
    req = urllib.request.Request(f"https://api.github.com/{path}",
                                 headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


text = (api(f"repos/{repo}/issues/{number}").get("body") or "") + "\n" + "\n".join(
    c.get("body") or "" for c in api(f"repos/{repo}/issues/{number}/comments?per_page=100"))
store = Path(os.getenv("ISSUE_FILES", Path.home() / ".local/share/issue-files")) / "github"
found = []
for url in re.findall(r"https://github\.com/[^\s)\"']+|https://(?:user-images|private-user-images)\.githubusercontent\.com/[^\s)\"']+", text):
    if url in found:
        continue
    found.append(url)
    match = re.search(r"/blob/issue-assets/(issue-assets/[^?\s)]+)", url)
    local = store / match.group(1) if match else None
    print(local if local and local.exists() else f"（本机无原件，可用共享浏览器打开）{url}")
if not found:
    print("该 issue 没有图片附件")
