#!/usr/bin/env bash
# issue-images <group/repo> <issue 编号> —— 列出 issue 正文与评论里的图片在本机的原件路径
# 原件由 gitlab-upload 存在 ~/.local/share/issue-files/；本机没有的给出网页链接（需浏览器登录查看）
set -euo pipefail
[ $# -eq 2 ] || { echo "用法: issue-images <group/repo> <issue 编号>" >&2; exit 2; }
host=${GITLAB_HOST:-git.garena.com}; repo=$1; iid=$2
store=${ISSUE_FILES:-$HOME/.local/share/issue-files}
project=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$repo")
{ GITLAB_HOST=$host glab api "projects/$project/issues/$iid" ; GITLAB_HOST=$host glab api "projects/$project/issues/$iid/notes?per_page=100"; } \
  | python3 -c '
import json, re, sys, os
store, host, repo = sys.argv[1:4]
text = sys.stdin.read()
seen = []
for secret, name in re.findall(r"/uploads/([0-9a-f]{32})/([^)\s\"\\\\]+)", text):
    if (secret, name) in seen:
        continue
    seen.append((secret, name))
    local = os.path.join(store, secret, name)
    print(local if os.path.exists(local) else f"（本机无原件，需网页登录查看）https://{host}/{repo}/uploads/{secret}/{name}")
if not seen:
    print("该 issue 没有图片附件")
' "$store" "$host" "$repo"
