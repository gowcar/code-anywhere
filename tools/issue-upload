#!/usr/bin/env python3
"""issue-upload <owner/repo> <文件>... —— 上传图片等附件，输出可直接贴进 issue 的 markdown。

GitLab：转交 gitlab-upload。GitHub 没有上传附件的 API：存到仓库的 issue-assets 分支（没有就从默认分支建），
贴 blob 链接（有仓库权限的人在网页上直接看到图）。原件另存 ~/.local/share/issue-files/github/，
本机会话用 issue-images 直接取原图。
"""
import base64, hashlib, json, os, shutil, subprocess, sys, urllib.error, urllib.request
from pathlib import Path

if len(sys.argv) < 3:
    sys.exit("用法: issue-upload <owner/repo> <文件>...")
here = Path(__file__).resolve().parent
platform = subprocess.run([str(here / "issue-platform")], capture_output=True, text=True).stdout.strip()
if platform != "github":
    os.execv(str(here / "gitlab-upload"), [str(here / "gitlab-upload"), *sys.argv[1:]])

repo, files = sys.argv[1], sys.argv[2:]
token_file = Path.home() / ".config/github-token"
token = token_file.read_text().strip() if token_file.exists() else subprocess.run(
    [shutil.which("gh") or "gh", "auth", "token"], capture_output=True, text=True).stdout.strip()
BRANCH = "issue-assets"


def api(method, path, body=None):
    req = urllib.request.Request(f"https://api.github.com/{path}", method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        return json.load(resp)


try:
    api("GET", f"repos/{repo}/branches/{BRANCH}")
except urllib.error.HTTPError as exc:
    if exc.code != 404:
        raise
    default = api("GET", f"repos/{repo}")["default_branch"]
    sha = api("GET", f"repos/{repo}/git/ref/heads/{default}")["object"]["sha"]
    api("POST", f"repos/{repo}/git/refs", {"ref": f"refs/heads/{BRANCH}", "sha": sha})

store = Path(os.getenv("ISSUE_FILES", Path.home() / ".local/share/issue-files")) / "github"
for name in files:
    data = Path(name).read_bytes()
    target = f"{BRANCH}/{hashlib.sha256(data).hexdigest()[:12]}-{Path(name).name}"
    try:
        api("PUT", f"repos/{repo}/contents/{target}",
            {"message": f"issue asset {Path(name).name}", "content": base64.b64encode(data).decode(), "branch": BRANCH})
    except urllib.error.HTTPError as exc:
        if exc.code != 422:   # 422 = 同内容已上传过
            raise
    (store / target).parent.mkdir(parents=True, exist_ok=True)
    shutil.copy(name, store / target)
    print(f"![{Path(name).name}](https://github.com/{repo}/blob/{BRANCH}/{target}?raw=true)")
