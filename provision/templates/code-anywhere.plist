<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.code-anywhere</string>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>-m</string>
    <string>src.main</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{PATH}}</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- 共享浏览器在桌面上开的 Chrome 不随服务重启被杀（Linux 上由 systemd-run 独立运行） -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>{{REPO}}/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/logs/launchd.log</string>
</dict>
</plist>
