# code-anywhere 配置（含密钥，权限 600，只有你自己能读）
# 位置：~/.config/code-anywhere/config.env
# ./setup 会帮你填能填的；没填的随时可以编辑本文件，改完运行 ./setup 或重启服务生效：
#   Linux：systemctl --user restart code-anywhere      macOS：launchctl kickstart -k gui/$(id -u)/com.code-anywhere
# 一行一项，KEY=值；值里有空格时用双引号。行首 # 表示没启用。

# ───────────────── Telegram（必填） ─────────────────
# @BotFather 创建 bot 时给的 token
BOT_TOKEN=
# 入口：私聊 Thread 模式时是你的 TG 用户 ID；话题群组时是群 ID（负数）。./setup 会自动识别
CHAT_ID=
# 允许使用的 TG 用户 ID，逗号分隔。./setup 只放你自己
ALLOWED_USERS=

# ───────────────── Claude ─────────────────
# 已经用 `claude auth login` 登录（订阅账号）就都不用填
# 用 API Key 计费时填：
# ANTHROPIC_API_KEY=
# 走自建网关 / 第三方服务时填地址和令牌（令牌按网关要求二选一填 KEY 或 AUTH_TOKEN）：
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=
# 默认模型（不填用 Claude Code 自己的默认）：
# ANTHROPIC_MODEL=

# ───────────────── Codex（只用 Claude 可以不管） ─────────────────
# 已经用 `codex login` 登录就不用填
# OPENAI_API_KEY=
# 走自建网关 / 兼容 OpenAI 的服务时填：
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# 新开 Codex 终端的默认模型（不填用 ~/.codex/config.toml 里的）：
# CODEX_MODEL=

# ───────────────── issue 流程（可选，配置时由 code-anywhere 会话帮你填） ─────────────────
# GitHub 令牌（不填就用 `gh auth token`）
# GITHUB_TOKEN=
# GitLab 地址和令牌
# GITLAB_HOST=gitlab.example.com
# GITLAB_TOKEN=

# ───────────────── 共享浏览器（可选） ─────────────────
# 远程查看默认走免费公共隧道，不用配。要用自己的隧道见 docs/REMOTE-VIEW-SETUP.md：
# BROWSER_HELP_SSH_HOST=
# BROWSER_HELP_LISTEN=
# BROWSER_HELP_PUBLIC_URL=
# BROWSER_HELP_WEBSOCKIFY=
# BROWSER_HELP_RESTORE=
# 同时可用的浏览器数（硬上限 4）、每个浏览器最多标签页数
# BROWSER_POOL_SLOTS=2
# BROWSER_POOL_MAX_TABS=6

# ───────────────── 其他 ─────────────────
# 本机服务端口（被占用时改一个）
BOT_PORT=5000
# /new 新建项目放在哪个目录下
# WORKSPACE_ROOT=~/workspace
# 上下文压缩满几次自动交接并换新会话（0 = 关闭）
# SESSION_ROTATE_AFTER_COMPACTIONS=3
